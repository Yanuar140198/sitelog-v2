# ===== Required =====
DATABASE_URL=postgresql://user:pass@host:5432/sitelog
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://sitelog.app

# ===== App URLs =====
NEXT_PUBLIC_API_URL=https://api.sitelog.app
NEXT_PUBLIC_WEB_URL=https://sitelog.app
BETTER_AUTH_TRUSTED_ORIGINS=https://sitelog.app,https://api.sitelog.app
# Server-side rewrite target (web → api, internal). Defaults to the public API URL.
API_INTERNAL_URL=http://api:4000
# Share the session cookie across subdomains (web + api). Set to the registrable
# domain with a leading dot, e.g. .sitelog.app — REQUIRED when web + api are on
# different subdomains, else the session won't stick after login.
AUTH_COOKIE_DOMAIN=.sitelog.app

# ===== Stripe billing =====
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx

# ===== Resend transactional email =====
RESEND_API_KEY=re_xxx
EMAIL_FROM=Sitelog <no-reply@sitelog.app>

# ===== Cloudflare R2 (S3-compatible) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PHOTOS=sitelog-photos
R2_BUCKET_EXPORTS=sitelog-exports
R2_PUBLIC_BASE=https://media.sitelog.app

# ===== Mobile + browser push =====
EXPO_ACCESS_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sitelog.app

# ===== Observability (optional, loaded only if set) =====
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ===== Platform internals =====
CRON_SECRET=replace-with-random
SITELOG_ADMIN_EMAILS=ops@sitelog.app
# Encrypts per-org BYO Anthropic keys (AI). Falls back to BETTER_AUTH_SECRET if unset.
SECRET_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
# Optional server-wide Claude key (fallback; orgs normally bring their own via /app/ai).
ANTHROPIC_API_KEY=
