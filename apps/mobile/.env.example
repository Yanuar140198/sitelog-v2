# Mobile env (Expo). Copy to .env for local `expo start` / Expo Go.
# EXPO_PUBLIC_* vars are inlined into the client bundle at build time.

# API origin the app talks to. Local dev points at a running API;
# for testing against the deployed backend use the staging or prod origin.
#   local:   http://<your-LAN-ip>:4000   (Expo Go can't reach localhost on the host)
#   staging: https://api-staging.k11ops.com
#   prod:    https://api.k11ops.com
EXPO_PUBLIC_API_URL=https://api-staging.k11ops.com
