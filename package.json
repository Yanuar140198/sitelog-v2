{
  "name": "sitelog",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:generate": "pnpm --filter @sitelog/db generate",
    "db:migrate": "pnpm --filter @sitelog/db migrate",
    "db:studio": "pnpm --filter @sitelog/db studio",
    "web:dev": "pnpm --filter @sitelog/web dev",
    "api:dev": "pnpm --filter @sitelog/api dev",
    "mobile:dev": "pnpm --filter @sitelog/mobile start",
    "dev:db": "bash scripts/dev-start.sh",
    "dev:db:stop": "docker stop sitelog-pg",
    "dev:db:reset": "docker rm -f sitelog-pg && bash scripts/dev-start.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "eslint": "^10.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}
